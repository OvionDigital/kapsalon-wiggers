---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CategorieBlok from "../components/behandelingen/CategorieBlok.astro";
import Galerij from "../components/home/Galerij.astro";
import herenImage from "../assets/man-haircut.jpg";
import damesImage from "../assets/woman-haircut.jpg";
import kinderenImage from "../assets/Kids-Haircut.webp";
import overigImage from "../assets/agustin-fernandez-Znyjl9pbaUs-unsplash.jpg";
import { categorieen } from "../data/behandelingen";
import { getSalonId } from "../lib/salon";

const [heren, dames, kinderen, overig] = categorieen;

const categorieItems = [
  { categorie: heren, image: herenImage, imageAlt: "Kapper knipt een heer" },
  { categorie: dames, image: damesImage, imageAlt: "Kapper stylet een dame" },
  {
    categorie: kinderen,
    image: kinderenImage,
    imageAlt: "Kapper knipt een kind",
  },
  {
    categorie: overig,
    image: overigImage,
    imageAlt: "Gereedschap van de kapsalon",
  },
];

// JSON-LD: OfferCatalog per categorie, gekoppeld aan de HairSalon uit
// BaseLayout via provider.@id.
const offerCatalog = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Behandelingen en tarieven",
  provider: { "@id": getSalonId(Astro.site) },
  itemListElement: categorieen.map((categorie) => ({
    "@type": "OfferCatalog",
    name: categorie.naam,
    itemListElement: categorie.behandelingen.map((behandeling) => ({
      "@type": "Offer",
      priceCurrency: "EUR",
      ...(typeof behandeling.prijs === "number"
        ? { price: behandeling.prijs }
        : {}),
      itemOffered: {
        "@type": "Service",
        name: behandeling.naam,
        ...(behandeling.toelichting
          ? { description: behandeling.toelichting }
          : {}),
      },
    })),
  })),
};
---

<BaseLayout
  title="Behandelingen & Tarieven | Kapsalon Wiggers — kapper in Wehl"
  description="Bekijk de tarieven van Kapsalon Wiggers in Wehl: knippen, kleuren en verzorging voor heren, dames en kinderen. Kapsalon prijzen Wehl, altijd met persoonlijk advies."
  extraJsonLd={[offerCatalog]}
>
  <PageHero
    title="Behandelingen & Tarieven"
    intro="Prijzen zijn indicatief en kunnen afhankelijk van haarlengte en gewenste behandeling afwijken. We geven je vooraf altijd een duidelijke indicatie."
    lijnVariant={2}
  />

  {
    categorieItems.map((item, i) => (
      <CategorieBlok
        categorie={item.categorie}
        image={item.image}
        imageAlt={item.imageAlt}
        omgekeerd={i % 2 === 1}
      />
    ))
  }

    <!-- <div class="bg-sand py-8">
      <div class="container">
        <p class="text-center text-small text-muted">
          Prijzen zijn indicatief en kunnen afhankelijk van haarlengte en gewenste
          behandeling afwijken — we geven je vooraf altijd een duidelijke
          indicatie.
        </p>
      </div>
    </div> -->

  <Galerij />
</BaseLayout>
