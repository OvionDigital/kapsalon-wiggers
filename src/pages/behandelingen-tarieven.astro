---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Intro from "../components/behandelingen/Intro.astro";
import CategorieBlok from "../components/behandelingen/CategorieBlok.astro";
import Producten from "../components/behandelingen/Producten.astro";
import AfspraakCta from "../components/home/AfspraakCta.astro";
import GalerijGrid from "../components/GalerijGrid.astro";
import Lightbox from "../components/Lightbox.astro";
import heroImage from "../assets/behandelingen-hero-placeholder.jpg";
import werkFoto1 from "../assets/werk-foto-1-placeholder.jpg";
import werkFoto2 from "../assets/werk-foto-2-placeholder.jpg";
import werkFoto3 from "../assets/werk-foto-3-placeholder.jpg";
import behandelingHeren from "../assets/behandeling-heren-placeholder.jpg";
import behandelingDames from "../assets/behandeling-dames-placeholder.jpg";
import behandelingKinderen from "../assets/behandeling-kinderen-placeholder.jpg";
import { categorieen } from "../data/behandelingen";
import { getSalonId } from "../lib/salon";

const [heren, dames, kinderen, overig] = categorieen;

const galerijItems = [
  { src: werkFoto1, alt: "Sfeerbeeld van een knipbeurt in uitvoering" },
  { src: behandelingHeren, alt: "Sfeerbeeld van een herenbehandeling" },
  { src: werkFoto2, alt: "Sfeerbeeld van de salon tijdens een behandeling" },
  { src: behandelingDames, alt: "Sfeerbeeld van een damesbehandeling" },
  { src: behandelingKinderen, alt: "Sfeerbeeld van een kinderbehandeling" },
  { src: werkFoto3, alt: "Sfeerbeeld van het vakwerk in de salon" },
];

// JSON-LD: OfferCatalog per categorie, gekoppeld aan de HairSalon uit
// BaseLayout via provider.@id.
const offerCatalog = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Behandelingen en tarieven",
  provider: { "@id": getSalonId(Astro.site) },
  itemListElement: categorieen.map((categorie) => ({
    "@type": "OfferCatalog",
    name: categorie.naam,
    itemListElement: categorie.behandelingen.map((behandeling) => ({
      "@type": "Offer",
      priceCurrency: "EUR",
      ...(typeof behandeling.prijs === "number"
        ? { price: behandeling.prijs }
        : {}),
      itemOffered: {
        "@type": "Service",
        name: behandeling.naam,
        ...(behandeling.toelichting
          ? { description: behandeling.toelichting }
          : {}),
      },
    })),
  })),
};
---

<BaseLayout
  title="Behandelingen & Tarieven | Kapsalon Wiggers — kapper in Wehl"
  description="Bekijk de tarieven van Kapsalon Wiggers in Wehl: knippen, kleuren en verzorging voor heren, dames en kinderen. Kapsalon prijzen Wehl, altijd met persoonlijk advies."
  extraJsonLd={[offerCatalog]}
>
  <PageHero
    eyebrow="Tarieven"
    title="Behandelingen & Tarieven"
    intro="Duidelijke prijzen voor heren, dames en kinderen — met altijd tijd voor advies vooraf."
    image={heroImage}
    imageAlt="Sfeerbeeld van behandelingen bij Kapsalon Wiggers"
  />

  <Intro />

  <CategorieBlok categorie={heren} achtergrond="sand" />
  <CategorieBlok categorie={dames} achtergrond="cream" />
  <CategorieBlok categorie={kinderen} achtergrond="sand" />
  <CategorieBlok categorie={overig} achtergrond="cream" />

  <div class="bg-sand py-8">
    <div class="container">
      <p class="text-center text-small text-muted">
        Prijzen zijn indicatief en kunnen afhankelijk van haarlengte en
        gewenste behandeling afwijken — we geven je vooraf altijd een
        duidelijke indicatie.
      </p>
    </div>
  </div>

  <section class="bg-cream">
    <div class="container">
      <h2 class="text-center">Sfeer en vakwerk</h2>
      <div class="mt-10">
        <GalerijGrid items={galerijItems} />
      </div>
    </div>
  </section>

  <Producten />
  <AfspraakCta />

  <Lightbox />
</BaseLayout>
