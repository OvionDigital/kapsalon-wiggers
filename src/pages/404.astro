---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pagina niet gevonden — Kapsalon Wiggers"
  description="Deze pagina bestaat niet (meer). Ga terug naar de homepage van Kapsalon Wiggers."
>
  <div class="container py-24 text-center">
    <p class="label text-muted">Foutcode 404</p>
    <h1 class="mt-4">Deze pagina bestaat niet</h1>
    <p class="container-prose mt-4 text-(length:--text-body) text-[var(--color-body)]">
      De pagina die je zoekt is verplaatst of bestaat niet (meer). Ga terug
      naar de homepage, of neem contact met ons op als je een afspraak wilt
      maken.
    </p>
    <a href="/" class="btn btn-primary mt-8 px-6 py-3 text-small">
      Terug naar de homepage
    </a>
  </div>
</BaseLayout>
