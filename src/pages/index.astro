---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Intro from "../components/home/Intro.astro";
import Behandelingen from "../components/home/Behandelingen.astro";
import Reviews from "../components/home/Reviews.astro";
import Galerij from "../components/home/Galerij.astro";
import OpeningstijdenLocatie from "../components/home/OpeningstijdenLocatie.astro";
import AfspraakCta from "../components/home/AfspraakCta.astro";
import FacebookSectie from "../components/home/FacebookSectie.astro";
---

<BaseLayout
  title="Kapsalon Wiggers | Dames- en herenkapsalon in Wehl"
  transparentHeader
>
  {
    /* overflow-x-hidden ipv overflow-hidden: de schaar mag rustig links van
       het canvas bleeden (juist de bedoeling), maar zonder horizontale
       scrollbar. Verticaal blijft alles onaangeroerd — de boekingskaart in
       de hero mag nog steeds net over de grens met Intro heen hangen. */
  }
  <div class="relative overflow-x-hidden">
    <Hero />
    <Intro />

    {
      /* Lichte, witte vorm met mix-blend-soft-light: soft-light laat wit op de
         donkere hero zachtjes oplichten tot een licht-grijze/witte afdruk die
         met de foto meeademt in plaats van er als vlakke pleister overheen te
         liggen. De subtiele drop-shadow geeft net genoeg reliëf
         om de contouren leesbaar te houden. Op de lichte Intro-sectie zakt
         de vorm vanzelf weg, wat hier prima is — hij hoort bij de hero.
         pointer-events-none zodat de knoppen eronder gewoon klikbaar
         blijven, ook waar de vorm eroverheen valt. Verborgen op mobiel: op
         een smal scherm zou zo'n groot element de tekst te veel verdringen. */
    }
    <svg
      class="pointer-events-none absolute top-8 -left-24 z-20 hidden h-184 w-auto -rotate-6 text-white opacity-40 mix-blend-soft-light drop-shadow-[0_2px_16px_rgba(0,0,0,0.2)] sm:block md:-left-36 md:h-216 lg:-left-44"
      viewBox="0 0 512 512"
      fill="none"
      aria-hidden="true"
