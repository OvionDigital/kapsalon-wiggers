---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Intro from "../components/home/Intro.astro";
import Behandelingen from "../components/home/Behandelingen.astro";
import Reviews from "../components/home/Reviews.astro";
import Galerij from "../components/home/Galerij.astro";
import OpeningstijdenLocatie from "../components/home/OpeningstijdenLocatie.astro";
---

<BaseLayout title="Kapsalon Wiggers | Dames- en herenkapsalon in Wehl">
  {
    /* overflow-x-hidden i.p.v. overflow-hidden: de scharen-decoratie in Hero
       mag links bleeden zonder een horizontale scrollbar te veroorzaken,
       maar verticaal blijft alles onaangeroerd — de boekingskaart in de hero
       moet nog steeds net over de grens met Intro heen kunnen hangen. */
  }
  <div class="overflow-x-hidden">
    <Hero />
    <Intro />
  </div>

  <Behandelingen />
  <Reviews />
  <Galerij />
  <OpeningstijdenLocatie />
</BaseLayout>
