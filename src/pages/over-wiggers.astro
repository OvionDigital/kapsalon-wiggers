---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Verhaal from "../components/over/Verhaal.astro";
import Tijdlijn from "../components/over/Tijdlijn.astro";
import Sfeer from "../components/over/Sfeer.astro";
---

<BaseLayout
  title="Over Wiggers | Familiebedrijf sinds 1932"
  description="Kapsalon Wiggers, sinds 1932 een familiebedrijf en sinds 1965 de vertrouwde kapper in Wehl. Lees ons verhaal en ontdek wat onze salon bijzonder maakt."
>
  <PageHero
    title="Over Wiggers"
    intro="Drie generaties knippen, één en dezelfde persoonlijke aandacht."
    lijnVariant={3}
  />

  <Verhaal />
  <Tijdlijn />
  <Sfeer />
</BaseLayout>
