---
/**
 * SmoothScroll — Lenis, voor het vloeiende "locomotive scroll"-gevoel.
 * Lenis stuurt gewoon de echte window-scrollpositie aan (geen eigen
 * transform-gebaseerde scrollcontainer), dus position:sticky, ankerlinks en
 * de scroll-listener in Header.astro blijven allemaal gewoon werken.
 *
 * Uit bij een voorkeur voor verminderde beweging — vloeiende
 * scroll-vertraging is precies het soort beweging waar mensen met
 * bewegingsgevoeligheid last van kunnen hebben (WCAG 2.3.3).
 */
---

<script>
  import Lenis from "lenis";
  import "lenis/dist/lenis.css";

  const wilAnimatie = window.matchMedia(
    "(prefers-reduced-motion: no-preference)",
  ).matches;

  if (wilAnimatie) {
    const lenis = new Lenis({
      autoRaf: true,
    });

    // Lenis houdt zijn eigen "virtuele" scrollpositie bij (los van de echte
    // window-scroll) om te kunnen vertragen — daardoor merkt Lenis een
    // paginawissel via de ClientRouter (BaseLayout.astro) niet vanzelf op en
    // blijft hij op de oude positie staan, ook al toont de pagina nu andere
    // inhoud. astro:after-swap (ná elke navigatie) forceert 'm terug naar
    // boven, met immediate: true zodat het geen zichtbare scroll-animatie
    // is maar meteen klopt.
    document.addEventListener("astro:after-swap", () => {
      lenis.scrollTo(0, { immediate: true });
    });
  }
</script>
