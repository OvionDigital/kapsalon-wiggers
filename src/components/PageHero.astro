---
import lijn2 from "../assets/background-line-2.svg?url";
import lijn3 from "../assets/background-line-3.svg?url";
import lijn4 from "../assets/background-line-4.svg?url";

interface Props {
  title: string;
  intro: string;
  /** Welke background-line-N.svg als decoratie achter de hero. */
  lijnVariant: 2 | 3 | 4;
}

const { title, intro, lijnVariant } = Astro.props;

// Een echte <img> i.p.v. background-image of content: url() op een
// pseudo-element — bij die twee wordt de afbeelding óf bijgesneden
// (background-size: cover) óf helemaal niet herschaald door width/height
// (content: url() negeert die CSS in de praktijk). Een <img> met w-full
// h-auto schaalt wel betrouwbaar mee op de intrinsieke verhouding, dus
// altijd volle breedte, nooit bijgesneden.
const lijnen = { 2: lijn2, 3: lijn3, 4: lijn4 } as const;
const lijnSrc = lijnen[lijnVariant];
---

<section id="page-hero" class="relative flex items-center pt-32 pb-16">
  <img
    src={lijnSrc}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 left-0 z-0 h-auto w-full -translate-y-1/2"
  />
  <div class="container relative z-10">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="mx-auto flex w-fit items-center gap-2 rounded-full bg-gold-light px-4 py-2 text-small font-semibold text-charcoal"
        ><span class="h-1 w-1 rounded-full bg-charcoal" aria-hidden="true"
        ></span>{title}</span
      >
      <h1 class="mt-6">{title}</h1>
      <p class="mt-4 text-(length:--text-body) text-(--color-body)">{intro}</p>
    </div>
  </div>
</section>
