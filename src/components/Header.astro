---
import Logo from "./Logo.astro";
import Nav from "./Nav.astro";
import AfspraakButton from "./AfspraakButton.astro";
import TopBar from "./TopBar.astro";
---

<header
  id="site-header"
  class="header-enter sticky top-0 z-40 bg-cream transition-[box-shadow,transform] duration-(--transition-duration-long)"
>
  <TopBar />

  <div id="nav-bar" class="bg-cream border-b border-border">
    <div class="container flex items-center justify-between py-5">
      <Logo variant="dark" />

      <div class="hidden items-center gap-6 md:flex">
        <Nav />
        <AfspraakButton kleur="sand" />
      </div>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex items-center justify-center rounded-sm p-2 text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menu openen</span>
        <svg
          id="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="hidden"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-cream md:hidden"
  >
    <Nav />
    <div class="px-4 pb-4">
      <AfspraakButton kleur="sand" class="w-full" />
    </div>
  </div>
</header>

<style>
  /* Laadanimatie: de header valt kort na het laden zachtjes op zijn plek. */
  /* Alleen opacity, geen transform: het scroll-script hierbeneden zet zijn
     eigen transform: translateY() op dit element om de topbar te
     verbergen/tonen. Een animation met "both" fill-mode wint via de
     CSS-cascade altijd van een inline style.transform (zichtbaar in
     devtools als "Overridden by animation styles") — dus zodra de
     animatie ook transform zou animeren, blijft translateY(0) permanent
     vastzitten en negeert de pagina alle latere scroll-updates. */
  @keyframes header-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .header-enter {
    animation: header-fade-in var(--duration-entrance) ease-out both;
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  const header = document.getElementById("site-header");
  const topBar = document.getElementById("top-bar");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    document.documentElement.classList.remove("no-scroll");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
      return;
    }
    toggle.setAttribute("aria-expanded", "true");
    menu?.classList.remove("hidden");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    document.documentElement.classList.add("no-scroll");
  });

  // Sluit het mobiele menu zodra een link erin wordt aangeklikt — ook de
  // afspraakknop, die geen paginanavigatie doet maar de dialoog opent. Zonder
  // dit zou het menu (en zijn no-scroll) achter de dialoog open blijven staan.
  menu?.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest("a");
    if (link) closeMenu();
  });

  // Topbar schuift weg zodra je naar beneden scrolt, en komt terug zodra je
  // omhoog scrolt — de hoofdnav (logo + menu) blijft altijd zichtbaar. In
  // plaats van de topbar zelf in te klappen (max-height) verschuiven we het
  // hele header-element met transform: translateY. Een max-height-overgang
  // verandert de layout-hoogte van de sticky header, en omdat de pagina
  // daaronder dan meeschuift, zag de scroll-listener halverwege de overgang
  // een vervalste scrollY-waarde — dat gaf het stotterende/knipperende
  // effect. transform raakt de document-flow niet aan, dus dat probleem is
  // er niet.
  const TOPBAR_THRESHOLD = 80;
  let lastY = window.scrollY;
  let topBarHeight = topBar?.offsetHeight ?? 0;

  window.addEventListener(
    "resize",
    () => {
      topBarHeight = topBar?.offsetHeight ?? 0;
    },
    { passive: true },
  );

  const updateScrollState = () => {
    const y = window.scrollY;

    if (topBar && header) {
      const scrollingDown = y > lastY;
      const verbergen = y > TOPBAR_THRESHOLD && scrollingDown;
      header.style.transform = verbergen
        ? `translateY(-${topBarHeight}px)`
        : "translateY(0)";
    }

    lastY = y;
  };

  updateScrollState();
  window.addEventListener("scroll", updateScrollState, { passive: true });
</script>
