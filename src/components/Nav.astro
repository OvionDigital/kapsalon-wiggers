---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/behandelingen-tarieven", label: "Behandelingen" },
  { href: "/over-wiggers", label: "Over ons" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<nav aria-label="Hoofdmenu">
  <ul
    class="flex flex-col gap-1 p-4 md:flex-row md:items-center md:gap-7 md:p-0"
  >
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);
        return (
          <li>
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "nav-link block rounded-full px-3 py-1.5 font-body text-label tracking-wide text-(--color-body) no-underline transition-colors duration-(--transition-duration) hover:text-ink md:rounded-none md:px-1",
                { "is-active text-ink": isActive },
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  /* Desktop: geen pill-achtergrond meer, maar een fijne gouden lijn die vanuit
     het midden opengroeit bij hover en blijft staan op de actieve pagina.
     Rustig genoeg voor een kapperssite, net wat meer leven dan een platte rij
     links. Mobiel houdt de simpele lijstweergave (media-query hieronder). */
  @media (min-width: 768px) {
    .nav-link {
      position: relative;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      left: 0.25rem;
      right: 0.25rem;
      bottom: 0.15rem;
      height: 1.5px;
      background-color: var(--color-gold);
      transform: scaleX(0);
      transform-origin: center;
      transition: transform var(--transition-duration) ease;
    }

    .nav-link:hover::after,
    .nav-link:focus-visible::after,
    .nav-link.is-active::after {
      transform: scaleX(1);
    }

    .nav-link.is-active {
      font-weight: 600;
    }
  }

  /* Mobiel: pill-achtergrond terug, want een onderlijn leest daar slecht in
     een verticale lijst. */
  @media (max-width: 767.98px) {
    .nav-link:hover {
      background-color: rgb(0 0 0 / 0.05);
    }

    .nav-link.is-active {
      background-color: rgb(0 0 0 / 0.08);
      font-weight: 600;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  // Header.astro (en dus dit menu) staat op transition:persist: bij een
  // paginanavigatie via de ClientRouter (BaseLayout.astro) blijft dezelfde
  // DOM-node gewoon staan i.p.v. te verversen, dus de server-gerenderde
  // "actieve link" (op basis van Astro.url.pathname tijdens de build) klopt
  // na de eerste navigatie niet meer. astro:page-load vuurt na het laden
  // én na elke swap, dus hiermee blijft de actieve link altijd kloppen.
  function syncActieveNavLink() {
    const currentPath = window.location.pathname;

    document
      .querySelectorAll<HTMLAnchorElement>(".nav-link")
      .forEach((link) => {
        const href = new URL(link.href).pathname;
        const isActive =
          href === "/" ? currentPath === "/" : currentPath.startsWith(href);

        link.classList.toggle("is-active", isActive);
        link.classList.toggle("text-ink", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
  }

  document.addEventListener("astro:page-load", syncActieveNavLink);
</script>
