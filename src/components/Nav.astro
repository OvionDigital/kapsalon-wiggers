---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/behandelingen-tarieven", label: "Behandelingen & Tarieven" },
  { href: "/over-wiggers", label: "Over Wiggers" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<nav aria-label="Hoofdmenu">
  <ul
    class="flex flex-col gap-1 p-4 md:flex-row md:items-center md:gap-1 md:p-0"
  >
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);
        return (
          <li>
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "block rounded-full px-3 py-1.5 font-body text-label tracking-wide text-sand no-underline transition-colors duration-(--transition-duration) hover:bg-white/10 hover:text-white",
                {
                  "bg-white/15 font-semibold text-white": isActive,
                },
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
