---
import FeatureBlock from "./FeatureBlock.astro";
import kinderstoelImage from "../../assets/feature-kinderstoel-placeholder.jpg";
import sfeerImage from "../../assets/feature-sfeer-placeholder.jpg";
import { features } from "../../data/over";

const afbeeldingen = {
  kinderstoel: kinderstoelImage,
  sfeer: sfeerImage,
} as const;
---

<section class="bg-sand">
  <div class="container">
    <h2 class="text-center">Sfeer en bijzonderheden</h2>

    <div class="mt-12 flex flex-col gap-16 md:gap-20">
      {
        features.map((feature) => (
          <FeatureBlock
            titel={feature.titel}
            tekst={feature.tekst}
            image={afbeeldingen[feature.afbeelding as keyof typeof afbeeldingen]}
            alt={feature.alt}
            beeldZijde={feature.beeldZijde}
          />
        ))
      }
    </div>
  </div>
</section>
