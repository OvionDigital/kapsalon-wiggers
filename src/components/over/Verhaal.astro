---
import { Image } from "astro:assets";
import oudeFotoImage from "../../assets/salon-oud-placeholder.jpg";
import { verhaal } from "../../data/over";
---

<section class="bg-cream">
  <div class="container">
    <div
      class="grid gap-10 md:grid-cols-12 md:items-center md:gap-14"
    >
      <div class="md:col-span-7">
        <h2>Ons verhaal</h2>
        <div
          class="mt-6 flex max-w-[var(--container-prose)] flex-col gap-4"
          data-reveal
        >
          {
            verhaal.paragrafen.map((paragraaf) => (
              <p class="text-(length:--text-body) text-(--color-body)">
                {paragraaf}
              </p>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-5">
        <figure data-reveal style="--reveal-delay: 120">
          <div id="verhaal-parallax" class="overflow-hidden rounded-md">
            <Image
              src={oudeFotoImage}
              alt="Oude foto van de kapsalon, kort na de opening"
              width={800}
              height={1000}
              loading="lazy"
              class="h-auto w-full scale-110 object-cover"
              style="will-change: transform;"
            />
          </div>
          <figcaption class="mt-3 text-small text-muted">
            {verhaal.oudeFotoOnderschrift}
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  // Parallax op de foto zelf (niet ín de afbeelding): de figure knipt met
  // overflow-hidden, de <img> erin is iets uitvergroot (scale-110) zodat er
  // speelruimte is om verticaal te verschuiven zonder witruimte te tonen.
  // Zelfde scroll-gekoppelde aanpak als de galerij (GalerijGrid.astro): Lenis
  // (SmoothScroll.astro) stuurt de echte window-scrollpositie aan, dus een
  // gewone scroll-listener volstaat.
  //
  // In astro:page-load gewrapt voor View Transitions (ClientRouter in
  // BaseLayout.astro): dit <script> draait als module maar één keer per
  // sessie, terwijl #verhaal-parallax bij elk bezoek een nieuwe DOM-node is.
  document.addEventListener("astro:page-load", () => {
    const figure = document.getElementById("verhaal-parallax");
    const img = figure?.querySelector("img");

    if (figure && img) {
      const wilAnimatie = window.matchMedia(
        "(prefers-reduced-motion: no-preference)",
      ).matches;

      if (wilAnimatie) {
        const snelheid = 0.15;
        let opgehangen = false;

        function bijwerken() {
          const rect = figure!.getBoundingClientRect();
          const viewportHoogte = window.innerHeight;
          const totaal = rect.height + viewportHoogte;
          const voortgang = Math.min(
            Math.max((viewportHoogte - rect.top) / totaal, 0),
            1,
          );
          const verschuiving = (voortgang - 0.5) * rect.height * snelheid;
          (img as HTMLElement).style.transform = `translateY(${verschuiving.toFixed(1)}px)`;
        }

        function opVolgendeFrame() {
          opgehangen = false;
          bijwerken();
        }

        function planBijwerken() {
          if (opgehangen) return;
          opgehangen = true;
          requestAnimationFrame(opVolgendeFrame);
        }

        // AbortController: window overleeft paginanavigaties zelf, dus
        // zonder opruimen zou elk hernieuwd bezoek een extra listener
        // stapelen. astro:before-swap ruimt 'm op vlak vóór de volgende
        // overgang.
        const controller = new AbortController();
        window.addEventListener("scroll", planBijwerken, {
          passive: true,
          signal: controller.signal,
        });
        window.addEventListener("resize", planBijwerken, {
          passive: true,
          signal: controller.signal,
        });
        document.addEventListener(
          "astro:before-swap",
          () => controller.abort(),
          { once: true },
        );
        bijwerken();
      }
    }
  });
</script>
