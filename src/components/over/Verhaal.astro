---
import { Image } from "astro:assets";
import oudeFotoImage from "../../assets/salon-oud-placeholder.jpg";
import { verhaal } from "../../data/over";
---

<section class="bg-cream">
  <div class="container">
    <div class="grid gap-10 md:grid-cols-12 md:items-start md:gap-14">
      <div class="md:col-span-7">
        <h2>Ons verhaal</h2>
        <div class="mt-6 flex max-w-[var(--container-prose)] flex-col gap-4">
          {
            verhaal.paragrafen.map((paragraaf) => (
              <p class="text-(length:--text-body) text-(--color-body)">
                {paragraaf}
              </p>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-5">
        <figure>
          <Image
            src={oudeFotoImage}
            alt="Oude foto van de kapsalon, kort na de opening"
            width={800}
            height={1000}
            loading="lazy"
            class="h-auto w-full rounded-md object-cover"
          />
          <figcaption class="mt-3 text-small text-muted">
            {verhaal.oudeFotoOnderschrift}
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
