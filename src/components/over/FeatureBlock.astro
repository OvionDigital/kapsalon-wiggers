---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  titel: string;
  tekst: string;
  image: ImageMetadata;
  alt: string;
  beeldZijde?: "links" | "rechts";
}

const { titel, tekst, image, alt, beeldZijde = "links" } = Astro.props;
const beeldRechts = beeldZijde === "rechts";
---

<div class="grid gap-8 md:grid-cols-2 md:items-center md:gap-14" data-reveal>
  <div class:list={[beeldRechts && "md:order-2"]}>
    <Image
      src={image}
      alt={alt}
      width={800}
      height={600}
      loading="lazy"
      class="h-auto w-full rounded-md object-cover"
    />
  </div>
  <div class:list={[beeldRechts && "md:order-1"]}>
    <h3 class="text-h3">{titel}</h3>
    <p class="mt-4 text-(length:--text-body) text-(--color-body)">{tekst}</p>
  </div>
</div>
