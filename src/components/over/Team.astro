---
import { Image } from "astro:assets";
import groepsfoto from "../../assets/team-groep-placeholder.jpg";
import team1 from "../../assets/team-1-placeholder.jpg";
import team2 from "../../assets/team-2-placeholder.jpg";
import team3 from "../../assets/team-3-placeholder.jpg";
import team4 from "../../assets/team-4-placeholder.jpg";
import { team } from "../../data/team";

const portretten = {
  "team-1": team1,
  "team-2": team2,
  "team-3": team3,
  "team-4": team4,
} as const;
---

<section class="bg-cream">
  <div class="container">
    <h2 class="text-center">Het team</h2>

    <Image
      src={groepsfoto}
      alt="Het team van Kapsalon Wiggers samen op de foto"
      width={1600}
      height={700}
      loading="lazy"
      class="mt-8 h-auto w-full rounded-md object-cover"
    />

    <div
      class="mt-10 grid grid-cols-2 gap-6 sm:gap-8 md:[grid-template-columns:repeat(auto-fit,minmax(12rem,1fr))]"
    >
      {
        team.map((lid, i) => (
          <div class="text-center" data-reveal style={`--reveal-delay: ${i * 90}`}>
            <Image
              src={portretten[lid.foto as keyof typeof portretten]}
              alt={`Portret van ${lid.naam}`}
              width={600}
              height={750}
              loading="lazy"
              class="aspect-[4/5] h-auto w-full rounded-md object-cover"
            />
            <p class="mt-3 font-semibold text-ink">{lid.naam}</p>
            <p class="text-small text-burgundy">{lid.functie}</p>
            <p class="mt-1 text-small text-muted">{lid.omschrijving}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
