---
import { Image } from "astro:assets";
import introImage from "../../assets/intro-portret-placeholder.jpg";
import { intro } from "../../data/home";
---

<section class="bg-cream">
  <div class="container">
    <div class="grid gap-10 md:grid-cols-12 md:items-center md:gap-14">
      <div class="md:col-span-7">
        <p class="label text-muted">{intro.eyebrow}</p>
        <h2 class="mt-3">{intro.heading}</h2>
        <div class="mt-6 flex max-w-[var(--container-prose)] flex-col gap-4">
          {
            intro.paragrafen.map((paragraaf) => (
              <p class="text-(length:--text-body) text-(--color-body)">
                {paragraaf}
              </p>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-5">
        <Image
          src={introImage}
          alt="Sfeerbeeld van de werkplek in Kapsalon Wiggers"
          width={900}
          height={1200}
          loading="lazy"
          class="h-auto w-full rounded-md object-cover"
        />
      </div>
    </div>
  </div>
</section>
