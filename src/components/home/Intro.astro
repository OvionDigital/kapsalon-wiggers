---
import { Image } from "astro:assets";
import introImage from "../../assets/intro-werkplek-echt.jpg";
import { intro } from "../../data/home";
---

<section class="intro bg-white">
  <div class="container">
    <div class="grid gap-10 md:grid-cols-12 md:items-center md:gap-24">
      <div class="md:order-1 md:col-span-6" data-reveal>
        <Image
          src={introImage}
          alt="Werkplek met kappersstoelen in Kapsalon Wiggers"
          width={900}
          height={900}
          loading="lazy"
          class="h-auto w-full rounded-[50rem] object-cover aspect-4/3"
        />
      </div>

      <div class="md:order-2 md:col-span-6" data-reveal style="--reveal-delay: 120">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-gold-light px-4 py-2 text-small font-semibold text-charcoal"
        >
          <span class="h-1 w-1 rounded-full bg-charcoal" aria-hidden="true"
          ></span>
          {intro.eyebrow}
        </span>
        <h2 class="mt-6">
          {intro.headingPrefix}<em class="text-gold italic"
            >{intro.headingAccent}</em
          >
        </h2>
        <div class="mt-6 flex max-w-[var(--container-prose)] flex-col gap-4">
          {
            intro.paragrafen.map((paragraaf) => (
              <p class="text-(length:--text-body) text-(--color-body)">
                {paragraaf}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
