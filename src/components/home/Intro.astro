---
import { Image } from "astro:assets";
import introImage from "../../assets/intro-werkplek-echt.jpg";
import { intro } from "../../data/home";
---

{
  /* isolate: zonder een eigen stacking-context zou de svg met -z-10 áchter de
     eigen sectie-achtergrond vallen (en dus onzichtbaar zijn zodra het verloop
     dekkend crème wordt — vandaar dat de lijn eerder halverwege "stopte"). */
}
<section class="relative isolate overflow-hidden bg-linear-to-br from-sand/50 via-cream to-cream">
  {
    /* Gebogen lijn als stille decoratie, echoot de bochten van de blob-vorm
       hiernaast. Vult de volle sectiebreedte (preserveAspectRatio="none") en
       wordt van links naar rechts onthuld zodra de sectie in beeld komt — via
       een clip-path op de svg, niet via een stroke-dash, zodat de volledige
       lijn altijd de eindtoestand is. -z-10 + section:relative houdt 'm achter
       de content. */
  }
  <svg
    class="intro-lijn pointer-events-none absolute inset-0 -z-10 h-full w-full text-burgundy/45"
    viewBox="0 0 1200 300"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M-100,210 C 250,60 480,255 720,150 C 980,55 1120,200 1300,90"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
    ></path>
  </svg>

  <div class="container">
    <div class="grid gap-10 md:grid-cols-12 md:items-center md:gap-14">
      <div class="md:order-2 md:col-span-7">
        <p class="label text-muted">{intro.eyebrow}</p>
        <h2 class="mt-3">{intro.heading}</h2>
        <div class="mt-6 flex max-w-[var(--container-prose)] flex-col gap-4">
          {
            intro.paragrafen.map((paragraaf) => (
              <p class="text-(length:--text-body) text-(--color-body)">
                {paragraaf}
              </p>
            ))
          }
        </div>
      </div>

      <div class="md:order-1 md:col-span-5">
        {
          /* clipPathUnits="objectBoundingBox" laat de vorm meeschalen met de
             afbeelding, ongeacht formaat — vandaar de svg-clipPath in plaats
             van een simpele CSS polygon(), die geen zachte bochten kan
             maken. */
        }
        <svg width="0" height="0" class="absolute" aria-hidden="true">
          <defs>
            <clipPath id="intro-blob" clipPathUnits="objectBoundingBox">
              <path
                d="M0.79,0.13 C0.94,0.24 0.98,0.53 0.89,0.72 C0.81,0.9 0.6,0.99 0.39,0.97 C0.19,0.95 0.02,0.82 0.01,0.62 C0,0.42 0.13,0.22 0.32,0.1 C0.5,-0.02 0.65,0.02 0.79,0.13 Z"
              ></path>
            </clipPath>
          </defs>
        </svg>
        <Image
          src={introImage}
          alt="Werkplek met kappersstoelen in Kapsalon Wiggers"
          width={900}
          height={900}
          loading="lazy"
          class="h-auto w-full object-cover [clip-path:url(#intro-blob)]"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* De onthul-animatie zit volledig in deze twee regels. Standaard (geen JS,
     of prefers-reduced-motion) krijgt de svg geen clip-path en staat de lijn
     dus meteen volledig in beeld. */
  .intro-lijn.intro-lijn--animeer {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.6s ease-out;
  }

  .intro-lijn.intro-lijn--animeer.is-visible {
    clip-path: inset(0 0 0 0);
  }
</style>

<script>
  const svg = document.querySelector<SVGSVGElement>(".intro-lijn");
  const wilAnimatie = window.matchMedia(
    "(prefers-reduced-motion: no-preference)",
  ).matches;

  if (svg && wilAnimatie) {
    // Verberg de lijn via een eigen frame, zodat de browser die begintoestand
    // vastlegt vóór we 'm laten onthullen.
    svg.classList.add("intro-lijn--animeer");

    requestAnimationFrame(() => {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            svg.classList.add("is-visible");
            observer.disconnect();
          }
        },
        { threshold: 0.15 },
      );
      observer.observe(svg);
    });
  }
</script>
