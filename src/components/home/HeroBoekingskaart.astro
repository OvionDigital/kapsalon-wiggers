---
import Openingstijden from "../Openingstijden.astro";
import { vestigingen } from "../../data/vestigingen";
import { getTelHref } from "../../lib/salon";

interface Props {
  class?: string;
  /** true = geen eigen kaart-chrome (achtergrond/padding/schaduw), voor
   *  gebruik binnen een element dat dat al levert — zoals AfspraakDialog. */
  bare?: boolean;
  /** false = geen "Alleen op afspraak"-badge — bv. in AfspraakDialog, waar
   *  die tekst al in de eigen intro-alinea staat. */
  metBadge?: boolean;
  /** false = openingstijden op volledig formaat i.p.v. compact — bv. in
   *  AfspraakDialog, waar meer ruimte is dan in de hero-kaart. */
  compacteTijden?: boolean;
}

const {
  class: className = "",
  bare = false,
  metBadge = true,
  compacteTijden = true,
} = Astro.props;
const vestiging = vestigingen[0];
const chromeClass = bare ? "" : "rounded-md bg-white p-5";
---

<div class={`${chromeClass} ${className}`}>
  {
    metBadge && (
      <span class="inline-flex items-center gap-1.5 rounded-full bg-burgundy px-3 py-1 text-small font-semibold tracking-wide text-white">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        Alleen op afspraak
      </span>
    )
  }

  <a
    href={`tel:${getTelHref(vestiging.telefoon)}`}
    class:list={[
      "flex items-center gap-2 text-[16px] font-semibold text-ink no-underline hover:text-burgundy",
      metBadge ? "mt-3" : "",
    ]}
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shrink-0 text-burgundy"
      aria-hidden="true"
    >
      <path
        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"
      ></path>
    </svg>
    {vestiging.telefoon}
  </a>

  <div class="mt-3 border-t border-border pt-3">
    <Openingstijden compact={compacteTijden} />
  </div>
</div>
