---
import { Image } from "astro:assets";
import heroImage from "../../assets/Firefly_Photorealistic editorial photograph inside a warm, upscale hair salon. A female_hairs 624775.jpg";
import AfspraakButton from "../AfspraakButton.astro";
import { hero } from "../../data/hero";
---

<section
  id="hero"
  class="relative flex items-center overflow-hidden bg-burgundy py-16 md:min-h-[max(75vh,30rem)] md:py-0"
>
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt="Sfeerbeeld van het interieur van Kapsalon Wiggers"
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-burgundy/70 via-burgundy/85 to-burgundy-dark/95"
    >
    </div>
  </div>

  <div class="container relative z-10">
    <div class="max-w-2xl text-left">
      <h1 class="hero-animate hero-animate-1 text-white">
        {
          hero.headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))
        }
      </h1>

      <p
        class="hero-animate hero-animate-2 mt-6 text-(length:--text-body) text-sand"
      >
        {hero.intro}
      </p>

      <div
        class="hero-animate hero-animate-3 mt-8 flex flex-wrap items-center gap-4"
      >
        <AfspraakButton label={hero.primaryCta} kleur="sand" size="sm" />
        <a
          href={hero.secondaryCta.href}
          class="btn btn-outline px-5 py-2.5 text-[18px]"
        >
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate {
    animation: hero-fade-up var(--duration-entrance) ease-out both;
  }

  .hero-animate-1 {
    animation-delay: 0ms;
  }
  .hero-animate-2 {
    animation-delay: 90ms;
  }
  .hero-animate-3 {
    animation-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
