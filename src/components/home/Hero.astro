---
import { Image } from "astro:assets";
import heroImage from "../../assets/Firefly_Photorealistic editorial photograph inside a warm, upscale hair salon. A female_hairs 624775.jpg";
import HeroBoekingskaart from "./HeroBoekingskaart.astro";
import { hero } from "../../data/hero";
---

{
  /* Geen overflow-hidden hier: de boekingskaart moet er op desktop net
     overheen kunnen hangen. De achtergrondfoto en de gradient hebben 'm niet
     nodig — die zijn zelf al object-cover/inset-0 en clippen daarmee al aan
     hun eigen box. */
}
<section
  id="hero"
  class="relative flex items-center bg-burgundy pt-(--header-height) pb-16 md:min-h-[max(82vh,40rem)] md:pb-0"
>
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt="Sfeerbeeld van het interieur van Kapsalon Wiggers"
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      format="avif"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
    {
      /* Twee lagen: een vrijwel neutrale donkere gradient voor het contrast,
         plus een dunne burgundy-waas voor een heel klein beetje warmte. Zo is
         de overlay donkergrijs/zwart in plaats van bruin. */
    }
    <div
      class="absolute inset-0 bg-gradient-to-b from-overlay/55 via-overlay/72 to-overlay/90"
    >
    </div>
    <div class="absolute inset-0 bg-burgundy/12 mix-blend-multiply"></div>
  </div>

  <div class="container relative z-10 pt-8 md:pt-0 md:pb-0">
    <div class="max-w-2xl text-left">
      <h1 class="hero-animate hero-animate-1 text-white">
        {
          hero.headingLines.map((line) => (
            <>
              {line}
              <br />
            </>
          ))
        }
      </h1>

      <p
        class="hero-animate hero-animate-2 mt-6 text-(length:--text-body) text-sand"
      >
        {hero.intro}
      </p>
    </div>
  </div>

  {
    /* Positioneringslaag die de hele sectiehoogte beslaat (niet alleen de
       tekstkolom, die veel korter is door de verticale centrering). Zo
       raakt "bottom" ook echt de onderrand van de hero, en hangt de kaart
       er met een kleine, vaste overlap (-bottom-10) overheen — verder blijft
       hij dus grotendeels ín de hero, precies andersom dan de vorige versie. */
  }
  <div class="pointer-events-none absolute inset-0 z-20 hidden md:block">
    <div class="container relative h-full">
      <HeroBoekingskaart
        class="hero-animate hero-animate-3 pointer-events-auto absolute right-0 -bottom-10 w-80"
      />
    </div>
  </div>
</section>

{
  /* Mobiel: geen ruimte voor een overlay, dus gewoon een blok direct na de
     hero — geen gat, want er is niets tussenin te overbruggen. */
}
<div class="container md:hidden">
  <HeroBoekingskaart class="hero-animate hero-animate-3 -mt-8 mb-8" />
</div>

<style is:global>
  /* is:global omdat hero-animate-3 hier wordt gedefinieerd maar toegepast op
     een element in HeroBoekingskaart.astro — een ander bestand, dus met een
     eigen Astro-scope. Zonder is:global zou de scoped CSS die klasse daar
     nooit raken. */
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-animate {
    animation: hero-fade-up var(--duration-entrance) ease-out both;
  }

  .hero-animate-1 {
    animation-delay: 0ms;
  }
  .hero-animate-2 {
    animation-delay: 90ms;
  }
  .hero-animate-3 {
    animation-delay: 180ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
