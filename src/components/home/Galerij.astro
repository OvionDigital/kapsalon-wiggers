---
import GalerijGrid from "../GalerijGrid.astro";
import Lightbox from "../Lightbox.astro";
import galerij1 from "../../assets/zoe-applbaum-j0143fogXSg-unsplash.jpg";
import galerij2 from "../../assets/nate-johnston-tgPrIYnW3g4-unsplash.jpg";
import galerij3 from "../../assets/lindsay-cash-Md_DhaFsnCQ-unsplash.jpg";
import galerij4 from "../../assets/jason-leung-2seUdPQNy_I-unsplash.jpg";
import galerij5 from "../../assets/ionela-mat-lps3FolQ6Ro-unsplash.jpg";
import galerij6 from "../../assets/giorgio-trovato-wSpkThmoZQc-unsplash.jpg";
import galerij7 from "../../assets/farhad-ibrahimzade-V2HDOQTJh3o-unsplash.jpg";
import galerij8 from "../../assets/agustin-fernandez-Znyjl9pbaUs-unsplash.jpg";
import galerij9 from "../../assets/adam-winger-fI-TKWjKYls-unsplash.jpg";
import { galerij } from "../../data/home";

const afbeeldingen = {
  "galerij-1": galerij1,
  "galerij-2": galerij2,
  "galerij-3": galerij3,
  "galerij-4": galerij4,
  "galerij-5": galerij5,
  "galerij-6": galerij6,
  "galerij-7": galerij7,
  "galerij-8": galerij8,
  "galerij-9": galerij9,
} as const;

const items = galerij.map((item) => ({
  src: afbeeldingen[item.bestand as keyof typeof afbeeldingen],
  alt: item.alt,
}));
---

<section class="bg-sand">
  <div class="container">
    <h2 class="text-center">Sfeer en vakwerk</h2>

    <div class="mt-10">
      <GalerijGrid items={items} />
    </div>
  </div>
</section>

<Lightbox />
