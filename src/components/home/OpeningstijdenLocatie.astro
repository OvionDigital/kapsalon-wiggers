---
import Openingstijden from "../Openingstijden.astro";
import { vestigingen } from "../../data/vestigingen";
import { openingstijdenSectie } from "../../data/home";
import { parkerenNotitie } from "../../data/contact";
import { getGoogleMapsEmbedSrc, getTelHref } from "../../lib/salon";

interface Props {
  /** Toont de parkeernotitie onder het adres — alleen relevant op de
   *  contactpagina, waar deze sectie de plek van ContactGegevens overneemt. */
  toonParkerenNotitie?: boolean;
}

const { toonParkerenNotitie = false } = Astro.props;
const vestiging = vestigingen[0];
const mapsEmbedSrc = getGoogleMapsEmbedSrc(
  vestiging.adres,
  vestiging.postcode,
  vestiging.plaats,
);
---

<section
  id={toonParkerenNotitie ? "contactgegevens" : undefined}
  class:list={[
    "bg-sand",
    toonParkerenNotitie && "scroll-mt-(--header-height)",
  ]}
>
  <div class="container">
    <span
      class="flex w-fit items-center gap-2 rounded-full bg-gold-light px-4 py-2 text-small font-semibold text-charcoal"
      ><span class="h-1 w-1 rounded-full bg-charcoal" aria-hidden="true"
      ></span>{openingstijdenSectie.eyebrow}</span
    >
    <h2 class="mt-6">
      {openingstijdenSectie.headingPrefix}<em class="text-gold italic"
        >{openingstijdenSectie.headingAccent}</em
      >
    </h2>

    {
      /* Kaart met adres + openingstijden overlapt de linkerrand van de
         kaart-embed — vandaar position:relative/absolute i.p.v. een grid:
         een grid kan kolommen niet over elkaar heen laten vallen. Op
         mobiel (geen md:) valt dat terug op een simpele gestapelde
         volgorde, want daar is geen ruimte voor overlap. Het geheel staat
         in een 12-koloms grid, verticaal gecentreerd op 10 kolommen breed
         (col-start-2), i.p.v. de volle containerbreedte. */
    }
    <div class="grid md:grid-cols-12">
      <div class="relative mt-16 md:col-span-10 md:col-start-2 md:mt-14">
        <div class="overflow-hidden rounded-md md:ml-64 lg:ml-72">
          <iframe
            src={mapsEmbedSrc}
            title={`Kaart met de ligging van Kapsalon Wiggers in ${vestiging.plaats}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-96 w-full border-0 md:h-176"></iframe>
        </div>

        <div
          class="relative z-10 -mt-10 mr-6 rounded-md bg-white p-8 md:absolute md:top-1/2 md:left-0 md:mt-0 md:mr-0 md:w-80 md:-translate-y-1/2 lg:w-96"
          data-reveal-fade
        >
          <h3>Locatie</h3>
          <address
            class="mt-2 text-(length:--text-body) text-(--color-body) not-italic"
          >
            {vestiging.naam}
            <br />
            {vestiging.adres}, {vestiging.postcode}
            {vestiging.plaats}
            <br />
            <a
              href={`tel:${getTelHref(vestiging.telefoon)}`}
              class="text-burgundy no-underline hover:underline"
            >
              {vestiging.telefoon}
            </a>
          </address>

          {
            toonParkerenNotitie && (
              <p class="mt-3 text-small text-muted">{parkerenNotitie}</p>
            )
          }

          <h3 class="mt-6">Openingstijden</h3>
          <div class="mt-2">
            <Openingstijden />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
