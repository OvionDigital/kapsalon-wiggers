---
import Openingstijden from "../Openingstijden.astro";
import { vestigingen } from "../../data/vestigingen";
import { openingstijdenSectie } from "../../data/home";
import { parkerenNotitie } from "../../data/contact";
import { getGoogleMapsEmbedSrc, getGoogleMapsHref, getTelHref } from "../../lib/salon";
import { kaartCategorie, kaartMelding } from "../../data/cookies";

interface Props {
  /** Toont de parkeernotitie onder het adres — alleen relevant op de
   *  contactpagina, waar deze sectie de plek van ContactGegevens overneemt. */
  toonParkerenNotitie?: boolean;
}

const { toonParkerenNotitie = false } = Astro.props;
const vestiging = vestigingen[0];
const mapsEmbedSrc = getGoogleMapsEmbedSrc(
  vestiging.adres,
  vestiging.postcode,
  vestiging.plaats,
);
const mapsHref = getGoogleMapsHref(
  vestiging.adres,
  vestiging.postcode,
  vestiging.plaats,
);
---

<section
  id={toonParkerenNotitie ? "contactgegevens" : undefined}
  class:list={[
    "bg-sand",
    toonParkerenNotitie && "scroll-mt-(--header-height)",
  ]}
>
  <div class="container">
    <span
      class="flex w-fit items-center gap-2 rounded-full bg-gold-light px-4 py-2 text-small font-semibold text-charcoal"
      ><span class="h-1 w-1 rounded-full bg-charcoal" aria-hidden="true"
      ></span>{openingstijdenSectie.eyebrow}</span
    >
    <h2 class="mt-6">
      {openingstijdenSectie.headingPrefix}<em class="text-gold-deep italic"
        >{openingstijdenSectie.headingAccent}</em
      >
    </h2>

    {
      /* Kaart met adres + openingstijden overlapt de linkerrand van de
         kaart-embed — vandaar position:relative/absolute i.p.v. een grid:
         een grid kan kolommen niet over elkaar heen laten vallen. Op
         mobiel (geen md:) valt dat terug op een simpele gestapelde
         volgorde, want daar is geen ruimte voor overlap. Het geheel staat
         in een 12-koloms grid, verticaal gecentreerd op 10 kolommen breed
         (col-start-2), i.p.v. de volle containerbreedte. */
    }
    <div class="grid md:grid-cols-12">
      <div class="relative mt-16 md:col-span-10 md:col-start-2 md:mt-14">
        {
          /* Google Maps plaatst cookies, dus de iframe laadt pas na
             toestemming voor de categorie "functional" in CookieFirst. Daarom
             data-src i.p.v. src (volgens de CookieFirst-handleiding voor
             iframes); CookieFirst of het script hieronder zet src zodra er
             toestemming is. Tot die tijd staat de melding in hetzelfde vlak. */
        }
        <div
          class="kaart relative h-96 overflow-hidden rounded-md bg-white md:ml-64 md:h-176 lg:ml-72"
        >
          <iframe
            data-src={mapsEmbedSrc}
            data-cookiefirst-category={kaartCategorie}
            title={`Kaart met de ligging van Kapsalon Wiggers in ${vestiging.plaats}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full w-full border-0"></iframe>
          <div
            class="kaart-melding absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 pb-16 text-center md:pb-6 md:pl-22 lg:pl-30"
          >
            <p class="max-w-xs text-small text-muted">{kaartMelding.tekst}</p>
            <button
              type="button"
              class="btn btn-primary px-6 py-3 text-small"
              data-kaart-toestaan
            >
              {kaartMelding.knop}
            </button>
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-small font-semibold text-burgundy underline underline-offset-4"
            >
              {kaartMelding.routeLink}
            </a>
          </div>
        </div>

        {
          /* Op mobiel hangt het locatieblok gecentreerd een stukje over de
             onderrand van de kaart. */
        }
        <div
          class="relative z-10 mx-6 -mt-10 rounded-md bg-white p-8 md:absolute md:top-1/2 md:left-0 md:mx-0 md:mt-0 md:w-80 md:-translate-y-1/2 lg:w-96"
          data-reveal-fade
        >
          <h3>Locatie</h3>
          <address
            class="mt-2 text-(length:--text-body) text-(--color-body) not-italic"
          >
            Kapsalon Wiggers
            <br />
            {vestiging.adres}
            <br />
            {`${vestiging.postcode} ${vestiging.plaats}`}
            <br />
            <a
              href={`tel:${getTelHref(vestiging.telefoon)}`}
              class="text-burgundy no-underline hover:underline"
            >
              {vestiging.telefoon}
            </a>
          </address>

          {
            toonParkerenNotitie && parkerenNotitie && (
              <p class="mt-3 text-small text-muted">{parkerenNotitie}</p>
            )
          }

          <h3 class="mt-6">Openingstijden</h3>
          <div class="mt-2">
            <Openingstijden />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Melding weg zodra de iframe een src heeft (toestemming gegeven). */
  .kaart iframe[src] ~ .kaart-melding {
    display: none;
  }
</style>

<script>
  import { kaartCategorie } from "../../data/cookies";

  type CookieFirstApi = {
    consent?: Record<string, boolean> | null;
    acceptCategory?: (categorie: string) => void;
  };
  const venster = window as Window & { CookieFirst?: CookieFirstApi };

  function laadKaarten() {
    document
      .querySelectorAll<HTMLIFrameElement>(
        `iframe[data-cookiefirst-category="${kaartCategorie}"]:not([src])`,
      )
      .forEach((iframe) => {
        if (iframe.dataset.src) iframe.src = iframe.dataset.src;
      });
  }

  function heeftToestemming() {
    return venster.CookieFirst?.consent?.[kaartCategorie] === true;
  }

  // Knop bij de kaart: geeft toestemming in CookieFirst en laadt de kaart
  // meteen. Is CookieFirst niet geladen (bv. op het pages.dev-adres of door
  // een adblocker), dan laden we de kaart op deze expliciete klik toch.
  document.addEventListener("click", (event) => {
    const knop = (event.target as Element | null)?.closest(
      "[data-kaart-toestaan]",
    );
    if (!knop) return;
    venster.CookieFirst?.acceptCategory?.(kaartCategorie);
    laadKaarten();
  });

  // Toestemming gegeven of gewijzigd via de banner.
  window.addEventListener("cf_consent", () => {
    if (heeftToestemming()) laadKaarten();
  });

  // Na een paginanavigatie via de ClientRouter verwerkt CookieFirst nieuwe
  // iframes niet vanzelf; bij eerder gegeven toestemming laden we ze hier.
  document.addEventListener("astro:page-load", () => {
    if (heeftToestemming()) laadKaarten();
  });
</script>
