---
import { facebook } from "../../data/home";
---

<section class="bg-cream">
  <div class="container flex flex-col items-center gap-3 text-center">
    <svg
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="text-burgundy"
      aria-hidden="true"
    >
      <path
        d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.86c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"
      ></path>
    </svg>
    <h2 class="label text-muted">Volg ons op Facebook</h2>
    <p class="text-(length:--text-body) text-(--color-body)">{facebook.tekst}</p>
    <a
      href={facebook.href}
      class="font-semibold text-burgundy no-underline hover:underline"
    >
      Bekijk onze Facebook-pagina
    </a>
  </div>
</section>
