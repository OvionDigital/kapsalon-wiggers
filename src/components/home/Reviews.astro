---
import { reviews } from "../../data/vestigingen";
import { uitgelichteReviews, reviewsSectie } from "../../data/home";

import jqueryUrl from "../../lib/owlcarousel/jquery-4.0.0.min.js?url";
import owlCarouselUrl from "../../lib/owlcarousel/owl.carousel.min.js?url";
import "../../lib/owlcarousel/owl.carousel.min.css";
import "../../lib/owlcarousel/owl.theme.default.min.css";

// Kleurcirkel-avatar i.p.v. een (verzonnen) profielfoto — zie de TODO bij
// uitgelichteReviews. Rouleert over een klein palet uit de bestaande tokens.
const avatarKleuren = ["bg-burgundy", "bg-gold-dark", "bg-olive"];

function initialen(naam: string) {
  return naam
    .split(" ")
    .map((deel) => deel[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}
---

<section class="reviews-carousel bg-cream overflow-x-hidden">
  <div class="container">
    <div
      class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center md:gap-14"
    >
      <div class="md:col-span-4 reviews-column-left">
        <div class="relative z-10" data-reveal>
          {
            /* Google-"G" als herkenningspunt — lokale inline svg, geen externe
             afbeelding of script, dus blijft trackervrij. */
          }
          <div class="flex items-center gap-3">
            <svg
              width="28"
              height="28"
              viewBox="0 0 48 48"
              aria-hidden="true"
              class="shrink-0"
            >
              <path
                fill="#4285F4"
                d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
              ></path>
              <path
                fill="#34A853"
                d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
              ></path>
              <path
                fill="#FBBC05"
                d="M11.69 28.18A13.98 13.98 0 0 1 10.93 24c0-1.45.25-2.87.76-4.18v-5.7H4.34A21.99 21.99 0 0 0 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"
              ></path>
              <path
                fill="#EA4335"
                d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
              ></path>
            </svg>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-h4 font-heading font-semibold text-burgundy">
                  {reviews.score}
                </span>
                <span class="flex items-center gap-0.5" aria-hidden="true">
                  {
                    Array.from({ length: 5 }).map(() => (
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="text-gold"
                      >
                        <path d="M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7-5.4-4.7 7.1-.6 2.9-6.6z" />
                      </svg>
                    ))
                  }
                </span>
              </div>
              <p class="text-small text-muted">
                uit {reviews.aantal} Google-reviews
              </p>
            </div>
          </div>
          {
            reviews.googleUrl && (
              <a
                href={reviews.googleUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-block text-small font-semibold text-burgundy hover:underline"
              >
                Bekijk alle reviews op Google
              </a>
            )
          }

          <span
            class="mt-8 flex w-fit items-center gap-2 rounded-full bg-gold-light px-4 py-2 text-small font-semibold text-charcoal"
          >
            <span class="h-1 w-1 rounded-full bg-charcoal" aria-hidden="true"
            ></span>{reviewsSectie.eyebrow}
          </span>
          <h2 class="mt-3">
            {reviewsSectie.headingPrefix}<em class="text-gold italic"
              >{reviewsSectie.headingAccent}</em
            >
          </h2>
          <p class="mt-4 text-(length:--text-body) text-(--color-body)">
            {reviewsSectie.paragraaf}
          </p>
        </div>
      </div>

      <div class="md:col-span-8" data-reveal style="--reveal-delay: 120">
        <div id="review-carousel" class="owl-carousel owl-theme">
          {
            uitgelichteReviews.map((review, i) => (
              <blockquote class="relative overflow-hidden rounded-md bg-white p-6 text-left">
                <svg
                  width="40"
                  height="40"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="absolute top-4 right-4 text-burgundy/10"
                  aria-hidden="true"
                >
                  <path d="M9.5 7C6.46 7 4 9.46 4 12.5S6.46 18 9.5 18c.34 0 .67-.03 1-.09-.53 1.6-2.03 2.84-3.85 3.05a.5.5 0 0 0 .07 1c3.3-.38 5.78-3.2 5.78-6.6V12.5C12.5 9.46 12.54 7 9.5 7Zm9 0C15.46 7 13 9.46 13 12.5S15.46 18 18.5 18c.34 0 .67-.03 1-.09-.53 1.6-2.03 2.84-3.85 3.05a.5.5 0 0 0 .07 1c3.3-.38 5.78-3.2 5.78-6.6V12.5C21.5 9.46 21.54 7 18.5 7Z" />
                </svg>

                <div class="flex items-center gap-3">
                  <span
                    class:list={[
                      "flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-small font-semibold text-white",
                      avatarKleuren[i % avatarKleuren.length],
                    ]}
                    aria-hidden="true"
                  >
                    {initialen(review.naam)}
                  </span>
                  <cite class="text-base font-semibold text-ink not-italic">
                    {review.naam}
                  </cite>
                </div>

                <span class="mt-4 flex items-center gap-0.5" aria-hidden="true">
                  {Array.from({ length: 5 }).map((_, si) => (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class:list={[
                        si < review.sterren ? "text-gold" : "text-border",
                      ]}
                    >
                      <path d="M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7-5.4-4.7 7.1-.6 2.9-6.6z" />
                    </svg>
                  ))}
                </span>
                <p class="mt-3 text-(length:--text-body) text-(--color-body)">
                  {review.tekst}
                </p>
              </blockquote>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ jqueryUrl, owlCarouselUrl }}>
  // jQuery/Owl bewust NIET als losse is:inline <script src>-tags: de
  // volgorde/timing daarvan bleek niet altijd betrouwbaar (met name na een
  // paginanavigatie via de ClientRouter kon owlCarousel() al aangeroepen
  // worden vóór het Owl-script klaar was — "jQuery(...).owlCarousel is not
  // a function"). Hieronder laden we ze zelf, in serie, met een expliciete
  // .onload-belofte per script, zodat init pas start als beide écht klaar
  // zijn — ongeacht hoe snel/traag dat gaat.
  function laadScript(src) {
    return new Promise((resolve, reject) => {
      const bestaand = document.querySelector(`script[data-bron="${src}"]`);
      if (bestaand) {
        // Al eerder geladen (bv. bij een herhaald bezoek aan deze pagina in
        // dezelfde sessie) — jQuery/Owl blijven als globals bestaan, dus
        // gewoon meteen doorgaan i.p.v. opnieuw ophalen.
        resolve();
        return;
      }
      const script = document.createElement("script");
      script.src = src;
      script.dataset.bron = src;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Kon ${src} niet laden`));
      document.body.appendChild(script);
    });
  }

  document.addEventListener("astro:page-load", () => {
    laadScript(jqueryUrl)
      .then(() => laadScript(owlCarouselUrl))
      .then(() => {
        const jQuery = window.jQuery;

        // Owl Carousel 2 (2019) roept een paar jQuery-statics aan die in
        // jQuery 4 zijn verwijderd — kleine shim zodat de bundel meegeleverd
        // in src/lib/owlcarousel/ zonder patches samenwerkt.
        if (!jQuery.camelCase) {
          jQuery.camelCase = (str) =>
            str.replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
        }
        if (!jQuery.type) {
          jQuery.type = (obj) =>
            obj === null || obj === undefined
              ? `${obj}`
              : Object.prototype.toString
                  .call(obj)
                  .match(/^\[object (.+)\]$/)[1]
                  .toLowerCase();
        }
        if (!jQuery.isFunction) {
          jQuery.isFunction = (obj) => typeof obj === "function";
        }
        if (!jQuery.isArray) {
          jQuery.isArray = Array.isArray;
        }
        if (!jQuery.isWindow) {
          jQuery.isWindow = (obj) => obj != null && obj === obj.window;
        }
        if (!jQuery.trim) {
          jQuery.trim = (str) => (str ?? "").toString().trim();
        }

        // Pijltjes i.p.v. de standaard "prev"/"next"-tekst van Owl.
        const pijlLinks = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>`;
        const pijlRechts = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>`;

        const $carousel = jQuery("#review-carousel").owlCarousel({
          items: 2,
          margin: 24,
          nav: true,
          navText: [pijlLinks, pijlRechts],
          dots: true,
          loop: false,
          responsive: {
            0: { items: 1 },
            768: { items: 2 },
          },
        });

        // De svg's zijn aria-hidden, dus de knoppen hebben zelf een naam
        // nodig voor schermlezers.
        $carousel.find(".owl-prev").attr("aria-label", "Vorige reviews");
        $carousel.find(".owl-next").attr("aria-label", "Volgende reviews");

        // Nav en dots samen op één rij: in een eigen wrapper gezet i.p.v.
        // via CSS op #review-carousel zelf, want Owl berekent zijn
        // breedtes/posities op basis van die eigen root en
        // .owl-stage-outer — daar niet aankomen.
        $carousel
          .find(".owl-nav, .owl-dots")
          .wrapAll('<div class="owl-controls-row"></div>');
      })
      .catch((error) => {
        console.error("Reviews-carousel kon niet laden:", error);
      });
  });
</script>
