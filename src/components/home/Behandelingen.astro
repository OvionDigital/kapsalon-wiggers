---
import { Image } from "astro:assets";
import herenImage from "../../assets/behandeling-heren-placeholder.jpg";
import damesImage from "../../assets/behandeling-dames-placeholder.jpg";
import kinderenImage from "../../assets/behandeling-kinderen-placeholder.jpg";
import { behandelingen } from "../../data/home";

const afbeeldingen = {
  heren: herenImage,
  dames: damesImage,
  kinderen: kinderenImage,
} as const;
---

<section class="bg-sand">
  <div class="container">
    <p class="label text-center text-muted">Voor iedereen</p>
    <h2 class="mt-3 text-center">Uitgelichte behandelingen</h2>

    <div class="behandeling-kaarten mt-12 grid gap-6 md:grid-cols-3 md:gap-8">
      {
        behandelingen.map((item) => (
          <article class="behandeling-kaart group relative isolate flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-sm shadow-lg shadow-ink/20 ring-1 ring-white/10">
            <Image
              src={afbeeldingen[item.afbeelding as keyof typeof afbeeldingen]}
              alt={`Portret — ${item.doelgroep.toLowerCase()}`}
              width={800}
              height={1000}
              loading="lazy"
              class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/5" />

            {/* Spiegel-glans die af en toe over de kaart trekt, alsof er licht
                langs een spiegel strijkt. */}
            <span class="kaart-glans pointer-events-none absolute inset-0" aria-hidden="true" />

            {/* Dunne haarlijn die zichzelf om de kaart tekent en om de paar
                seconden opnieuw langsloopt. pathLength="100" maakt de
                dash-berekening onafhankelijk van de kaartafmeting;
                non-scaling-stroke houdt de lijndikte gelijk. */}
            <svg
              class="behandeling-kaart-kader pointer-events-none absolute inset-0 h-full w-full text-cream/55"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect
                x="1.4"
                y="1.4"
                width="97.2"
                height="97.2"
                rx="1.2"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
                pathLength="100"
              />
            </svg>

            <div class="relative p-6">
              <h3 class="font-heading text-h3 leading-tight text-white">
                <a
                  href={`/behandelingen-tarieven#${item.afbeelding}`}
                  class="text-white no-underline after:absolute after:inset-0 after:content-[''] hover:text-white"
                >
                  {item.doelgroep}
                  <span class="sr-only">
                    {" "}
                    — bekijk alle behandelingen en tarieven
                  </span>
                </a>
              </h3>
              <p class="mt-1 text-(length:--text-body) text-cream/85">
                {item.behandeling}
              </p>
              <p class="mt-3 inline-flex items-baseline rounded-full bg-gold px-3 py-1 text-small font-semibold text-charcoal">
                {item.vanaf ? "vanaf " : ""}
                {item.prijs}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a href="/behandelingen-tarieven" class="btn btn-primary px-6 py-3">
        Bekijk alle behandelingen &amp; tarieven
      </a>
    </div>
  </div>
</section>

<style>
  /* Standaard (geen JS of prefers-reduced-motion) staat de haarlijn meteen
     volledig om de kaart en beweegt de glans niet. Alle animatie zit onder
     .kaders-animeren.in-view. */
  .behandeling-kaart-kader rect {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }

  .kaart-glans {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgb(255 255 255 / 0.12) 47%,
      rgb(255 255 255 / 0.24) 50%,
      rgb(255 255 255 / 0.12) 53%,
      transparent 60%
    );
    mix-blend-mode: screen;
    transform: translateX(-130%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .kaders-animeren .behandeling-kaart-kader rect {
      stroke-dashoffset: 100;
    }

    .kaders-animeren.in-view .behandeling-kaart-kader rect {
      animation: kader-teken 8s ease-in-out infinite;
    }

    .kaders-animeren.in-view .kaart-glans {
      animation: kaart-glans-sweep 8s ease-in-out infinite;
    }

    .kaders-animeren.in-view
      .behandeling-kaart:nth-child(2)
      :is(.behandeling-kaart-kader rect, .kaart-glans) {
      animation-delay: 0.6s;
    }

    .kaders-animeren.in-view
      .behandeling-kaart:nth-child(3)
      :is(.behandeling-kaart-kader rect, .kaart-glans) {
      animation-delay: 1.2s;
    }
  }

  /* -100 ≡ 100 (mod 2 × dasharray), dus 100% loopt naadloos over in 0%. */
  @keyframes kader-teken {
    0% {
      stroke-dashoffset: 100;
    }
    28% {
      stroke-dashoffset: 0;
    }
    72% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -100;
    }
  }

  @keyframes kaart-glans-sweep {
    0%,
    12% {
      transform: translateX(-130%);
    }
    34% {
      transform: translateX(130%);
    }
    100% {
      transform: translateX(130%);
    }
  }
</style>

<script>
  const grid = document.querySelector(".behandeling-kaarten");
  const wilAnimatie = window.matchMedia(
    "(prefers-reduced-motion: no-preference)",
  ).matches;

  if (grid && wilAnimatie) {
    grid.classList.add("kaders-animeren");

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          grid.classList.toggle("in-view", entry.isIntersecting);
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(grid);
  }
</script>
