---
import { Image } from "astro:assets";
import herenImage from "../../assets/behandeling-heren-placeholder.jpg";
import damesImage from "../../assets/behandeling-dames-placeholder.jpg";
import kinderenImage from "../../assets/behandeling-kinderen-placeholder.jpg";
import { behandelingen } from "../../data/home";

const afbeeldingen = {
  heren: herenImage,
  dames: damesImage,
  kinderen: kinderenImage,
} as const;
---

<section class="bg-sand">
  <div class="container">
    <h2 class="text-center">Uitgelichte behandelingen</h2>

    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {
        behandelingen.map((behandeling) => (
          <article class="group relative overflow-hidden rounded-md bg-cream transition-shadow duration-(--transition-duration) hover:shadow-lg">
            <div class="overflow-hidden">
              <Image
                src={afbeeldingen[behandeling.afbeelding as keyof typeof afbeeldingen]}
                alt={`Sfeerbeeld van een ${behandeling.titel.toLowerCase()}behandeling`}
                width={800}
                height={600}
                loading="lazy"
                class="h-48 w-full object-cover transition-transform duration-(--transition-duration) group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <h3 class="text-h4">
                <a
                  href="/behandelingen-tarieven"
                  class="static text-ink no-underline after:absolute after:inset-0 after:content-[''] hover:text-burgundy"
                >
                  {behandeling.titel}
                  <span class="sr-only"> — bekijk behandelingen en tarieven</span>
                </a>
              </h3>
              <p class="mt-2 text-small text-muted">{behandeling.beschrijving}</p>
              <p class="mt-3 font-semibold text-burgundy">
                Vanaf &euro;{behandeling.vanafPrijs}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
