---
import type { Categorie } from "../../data/behandelingen";
import { formatPrijs } from "../../lib/prijzen";

interface Props {
  categorie: Categorie;
  achtergrond: "cream" | "sand";
}

const { categorie, achtergrond } = Astro.props;
---

<section
  id={categorie.id}
  class:list={[
    "scroll-mt-(--header-height)",
    achtergrond === "sand" ? "bg-sand" : "bg-cream",
  ]}
>
  <div class="container">
    <div class="mx-auto max-w-[var(--container-prose)]">
      <h2>{categorie.naam}</h2>
      <p class="mt-3 text-(length:--text-body) text-(--color-body)">
        {categorie.omschrijving}
      </p>

      <table class="mt-6 w-full border-collapse text-left">
        <caption class="sr-only">Tarieven {categorie.naam}</caption>
        <tbody>
          {
            categorie.behandelingen.map((behandeling) => (
              <tr class="border-b border-border">
                <td class="py-2 pr-4 align-top text-ink">
                  {behandeling.naam}
                  {behandeling.toelichting && (
                    <span class="block text-small text-muted">
                      {behandeling.toelichting}
                    </span>
                  )}
                </td>
                <td class="py-2 text-right font-semibold whitespace-nowrap align-top text-ink">
                  {formatPrijs(behandeling.prijs)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
