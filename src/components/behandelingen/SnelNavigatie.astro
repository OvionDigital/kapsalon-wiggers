---
import { categorieen } from "../../data/behandelingen";
---

<nav
  aria-label="Snelnavigatie behandelingen"
  class="sticky top-(--header-height) z-30 border-b border-border bg-cream"
>
  <div class="container">
    <ul class="flex gap-1 overflow-x-auto py-3 text-small">
      {
        categorieen.map((categorie) => (
          <li>
            <a
              href={`#${categorie.id}`}
              data-snelnav-link
              data-target={categorie.id}
              class="block rounded-full px-3 py-1.5 whitespace-nowrap text-muted no-underline transition-colors duration-(--transition-duration) hover:text-burgundy"
            >
              {categorie.naam}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-snelnav-link]"),
  );
  const sections = links
    .map((link) => document.getElementById(link.dataset.target ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  const setActive = (id: string) => {
    for (const link of links) {
      const isActive = link.dataset.target === id;
      link.classList.toggle("bg-sand", isActive);
      link.classList.toggle("font-semibold", isActive);
      link.classList.toggle("text-burgundy", isActive);
      link.classList.toggle("text-muted", !isActive);
      link.setAttribute("aria-current", isActive ? "true" : "false");
    }
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );

  sections.forEach((section) => observer.observe(section));
</script>
