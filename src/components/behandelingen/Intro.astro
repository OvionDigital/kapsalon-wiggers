---
const tekst =
  "Bij Wiggers kun je terecht voor alles rond haar — van een klassieke herenknip tot kleuradvies voor dames en de allereerste knipbeurt van je kind. We nemen altijd de tijd om samen te kijken wat bij je past, voordat we beginnen.";
---

<section class="bg-cream">
  <div class="container">
    <p class="max-w-[var(--container-prose)] text-(length:--text-body) text-(--color-body)">
      {tekst}
    </p>
  </div>
</section>
