---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  achtergrond: "cream" | "sand";
}

const { src, alt, achtergrond } = Astro.props;
---

<section class={achtergrond === "sand" ? "bg-sand" : "bg-cream"}>
  <div class="container">
    <Image
      src={src}
      alt={alt}
      width={1600}
      height={900}
      loading="lazy"
      class="h-auto w-full rounded-md object-cover"
    />
  </div>
</section>
