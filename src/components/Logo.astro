---
/**
 * Logo — het echte woordmerk van de klant, ingeladen als inline SVG (niet
 * <img>) zodat fill="currentColor" in het bestand kan meekleuren met de
 * variant-prop. Zo werkt hetzelfde bestand op zowel de donkere header/footer
 * als een eventuele lichte achtergrond.
 */
import fs from "node:fs";
import path from "node:path";

interface Props {
  variant?: "dark" | "light";
  /** large = 150% van compact (3.375rem i.p.v. 2.25rem) — voor de header
   *  boven een full-bleed hero, die groot start en compact wordt na scrollen. */
  size?: "compact" | "large";
  class?: string;
}

const {
  variant = "dark",
  size = "compact",
  class: className = "",
} = Astro.props;
const wordmarkColor = variant === "light" ? "text-white" : "text-ink";
const sizeClass = size === "large" ? "h-[3.375rem]" : "h-9";

const logoSvg = fs.readFileSync(
  path.join(process.cwd(), "public/images/Logo-Kapsalon-Wiggers.svg"),
  "utf-8",
);
---

<a
  href="/"
  aria-label="Kapsalon Wiggers - Naar de homepage"
  class={`inline-flex items-center no-underline ${wordmarkColor} ${className}`}
>
  <span
    data-logo
    class={`w-auto origin-left transition-[height] duration-(--transition-duration) ease-out [&>svg]:h-full [&>svg]:w-auto ${sizeClass}`}
    aria-hidden="true"
    set:html={logoSvg}
  />
</a>
