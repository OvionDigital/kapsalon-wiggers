---
import { vestigingen } from "../data/vestigingen";
import { vandaagAfkorting, parseDagenNL } from "../lib/openingstijden";

interface Props {
  /** Strakkere regels (kleinere tekst, minder padding) — bv. de boekingskaart
   *  in de hero, waar verticale ruimte schaars is. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const vestiging = vestigingen[0];
const vandaag = vandaagAfkorting();
---

<dl class:list={["flex flex-col", compact ? "gap-0.5" : "gap-1"]}>
  {
    vestiging.openingstijden.map((tijd) => {
      const isVandaag = parseDagenNL(tijd.dagen).includes(vandaag);
      return (
        <div
          class:list={[
            "flex items-baseline justify-between gap-4",
            compact
              ? "rounded-md px-2.5 py-1"
              : "rounded-lg px-3 py-2 text-(length:--text-body)",
            isVandaag && "bg-sand",
          ]}
        >
          <dt
            class:list={[
              "font-medium",
              isVandaag ? "text-ink" : "text-(--color-body)",
            ]}
          >
            {tijd.dagen}
          </dt>
          <dd
            class:list={[
              "m-0",
              isVandaag ? "font-semibold text-ink" : "text-(--color-body)",
            ]}
          >
            {tijd.tijden}
          </dd>
        </div>
      );
    })
  }
</dl>
