---
import { Image } from "astro:assets";
import kaartImage from "../../assets/kaart-placeholder.jpg";
import { vestigingen } from "../../data/vestigingen";
import { getGoogleMapsHref } from "../../lib/salon";

const vestiging = vestigingen[0];
const mapsHref = getGoogleMapsHref(
  vestiging.adres,
  vestiging.postcode,
  vestiging.plaats,
);
---

<section class="bg-sand">
  <div class="container">
    <h2 class="text-center">Zo vind je ons</h2>

    <div class="mx-auto mt-10 max-w-3xl">
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative block overflow-hidden rounded-md"
      >
        <Image
          src={kaartImage}
          alt={`Plattegrond met de ligging van Kapsalon Wiggers in ${vestiging.plaats}`}
          width={1200}
          height={800}
          loading="lazy"
          class="h-64 w-full object-cover transition-transform duration-(--transition-duration) group-hover:scale-105"
        />
        <span
          class="absolute inset-0 flex items-center justify-center bg-ink/0 text-small font-semibold text-white opacity-0 transition-opacity duration-(--transition-duration) group-hover:bg-ink/40 group-hover:opacity-100"
        >
          Open in Google Maps
          <span class="sr-only"> (opent in een nieuw tabblad)</span>
        </span>
      </a>

      <div class="mt-6 text-center">
        <a
          href={mapsHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary px-6 py-3 text-small"
        >
          Route plannen
          <span class="sr-only"> (opent Google Maps in een nieuw tabblad)</span>
        </a>
      </div>
    </div>
  </div>
</section>
