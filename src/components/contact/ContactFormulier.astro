---
import {
  formulierBevestiging,
  privacyRegel,
  turnstileSiteKey,
} from "../../data/contact";
import { vestigingen } from "../../data/vestigingen";
import { getTelHref } from "../../lib/salon";

const vestiging = vestigingen[0];

const inputClass =
  "mt-2 w-full rounded-md border border-border bg-cream px-5 py-3.5 text-(length:--text-body) text-ink placeholder:text-muted focus-visible:bg-white";
---

<section class="bg-cream">
  <div class="container">
    <div class="mx-auto max-w-[var(--container-prose)] text-center">
      <h2>Stuur ons een bericht</h2>
      <p class="mt-3 text-(length:--text-body) text-(--color-body)">
        Liever mailen? Vul het formulier in en we reageren zo snel mogelijk.
      </p>
    </div>

    <div class="mx-auto mt-8 max-w-md">
      <div class="rounded-3xl bg-white p-6 shadow-sm sm:p-10" data-reveal>
      <form
        id="contact-form"
        method="POST"
        action="/api/contact"
        class="flex flex-col gap-6 text-left"
      >
        <div>
          <label for="naam" class="block text-small font-semibold text-ink">
            Naam
          </label>
          <input
            type="text"
            id="naam"
            name="naam"
            autocomplete="name"
            required
            aria-describedby="naam-fout"
            class={inputClass}
          />
          <p id="naam-fout" class="mt-1 text-small text-(--color-error)" hidden></p>
        </div>

        <div>
          <label for="email" class="block text-small font-semibold text-ink">
            E-mailadres
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            aria-describedby="email-fout"
            class={inputClass}
          />
          <p id="email-fout" class="mt-1 text-small text-(--color-error)" hidden></p>
        </div>

        <div>
          <label
            for="telefoon"
            class="block text-small font-semibold text-ink"
          >
            Telefoonnummer <span class="font-normal text-muted">(optioneel)</span>
          </label>
          <input
            type="tel"
            id="telefoon"
            name="telefoon"
            autocomplete="tel"
            class={inputClass}
          />
        </div>

        <div>
          <label
            for="bericht"
            class="block text-small font-semibold text-ink"
          >
            Bericht
          </label>
          <textarea
            id="bericht"
            name="bericht"
            rows="5"
            required
            aria-describedby="bericht-fout"
            class={inputClass}
          ></textarea>
          <p id="bericht-fout" class="mt-1 text-small text-(--color-error)" hidden>
          </p>
        </div>

        {
          /* Honeypot — verborgen via clip (net als .sr-only), bewust niet
             display:none, want daar reageren simpele spambots juist niet op.
             aria-hidden + tabindex="-1" houdt hem weg bij toetsenbord/AT. */
        }
        <div class="sr-only" aria-hidden="true">
          <label for="website">Laat dit veld leeg</label>
          <input
            type="text"
            id="website"
            name="website"
            tabindex="-1"
            autocomplete="off"
            class="w-px"
          />
        </div>
        <input type="hidden" id="ts" name="ts" value="" />

        {
          /* Cloudflare Turnstile. Het widget zet zelf een verborgen
             "cf-turnstile-response"-veld in dit formulier. */
        }
        <div id="turnstile-widget" data-sitekey={turnstileSiteKey}></div>

        <button
          type="submit"
          id="contact-submit"
          class="btn btn-primary self-start px-8 py-3.5 text-small"
        >
          <span data-submit-label>Versturen</span>
        </button>

        <p
          id="contact-status"
          role="status"
          aria-live="polite"
          class="text-small text-ink"
        >
        </p>
      </form>

      {
        /* Bevestiging na verzenden: vervangt het formulier op dezelfde plek. */
      }
      <div id="contact-bevestiging" class="py-4 text-center" hidden>
        <span
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gold-light text-burgundy"
          aria-hidden="true"
        >
          <svg
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        <h3
          id="contact-bevestiging-titel"
          tabindex="-1"
          class="mt-6 focus:outline-none"
        >
          {formulierBevestiging.titel}
        </h3>
        <p class="mt-3 text-(length:--text-body) text-(--color-body)">
          {formulierBevestiging.tekst}
        </p>
        <p class="mt-3 text-small text-muted">
          {formulierBevestiging.telefoonIntro}{" "}
          <a
            href={`tel:${getTelHref(vestiging.telefoon)}`}
            class="font-semibold whitespace-nowrap text-burgundy underline underline-offset-4"
          >
            {vestiging.telefoon}
          </a>.
        </p>
        <button
          type="button"
          id="contact-opnieuw"
          class="btn mt-8 border border-burgundy bg-transparent px-6 py-3 text-small text-burgundy hover:bg-burgundy hover:text-white"
        >
          {formulierBevestiging.opnieuw}
        </button>
      </div>
      </div>

      <p class="mt-6 text-center text-small text-muted">
        {privacyRegel}{" "}
        <a href="/privacyverklaring/" class="text-burgundy underline underline-offset-4">
          Lees onze privacyverklaring
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  interface Turnstile {
    render(
      element: HTMLElement,
      opties: Record<string, unknown>,
    ): string | undefined;
    reset(widgetId?: string): void;
  }
  const turnstileVenster = window as Window & { turnstile?: Turnstile };

  // Het Turnstile-script één keer per sessie laden (expliciete render-modus,
  // omdat het widget bij elke paginanavigatie via de ClientRouter in een
  // nieuwe DOM-node moet komen).
  let turnstileGeladen: Promise<Turnstile> | null = null;
  function laadTurnstile() {
    turnstileGeladen ??= new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src =
        "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.onload = () =>
        turnstileVenster.turnstile
          ? resolve(turnstileVenster.turnstile)
          : reject(new Error("Turnstile niet beschikbaar"));
      script.onerror = () => {
        turnstileGeladen = null;
        reject(new Error("Kon Turnstile niet laden"));
      };
      document.head.appendChild(script);
    });
    return turnstileGeladen;
  }

  // In astro:page-load gewrapt voor View Transitions (ClientRouter in
  // BaseLayout.astro): dit <script> draait als module maar één keer per
  // sessie, terwijl #contact-form bij elk bezoek een nieuwe DOM-node is.
  document.addEventListener("astro:page-load", () => {
  const widget = document.getElementById("turnstile-widget");
  let widgetId: string | undefined;
  if (widget?.dataset.sitekey) {
    laadTurnstile()
      .then((turnstile) => {
        widgetId = turnstile.render(widget, {
          sitekey: widget.dataset.sitekey,
          language: "nl",
          theme: "light",
          // "flexible" is minimaal 300px breed; op heel smalle schermen (320px)
          // past dat niet in het formulier, dan de compacte variant.
          size: widget.offsetWidth < 300 ? "compact" : "flexible",
        });
      })
      .catch((error) => console.error(error));
  }
  const resetTurnstile = () => {
    if (widgetId !== undefined) turnstileVenster.turnstile?.reset(widgetId);
  };

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("contact-status");
  const submitButton = document.getElementById(
    "contact-submit",
  ) as HTMLButtonElement | null;
  const submitLabel = submitButton?.querySelector("[data-submit-label]");

  if (form && statusEl && submitButton) {
    // novalidate wordt alleen via JS gezet: zonder JS blijft de native
    // HTML-validatie (required/type=email) volledig intact.
    form.setAttribute("novalidate", "");

    const tsField = document.getElementById("ts") as HTMLInputElement | null;
    if (tsField) tsField.value = String(Date.now());

    const velden = ["naam", "email", "bericht"] as const;
    // Pas na een eerste (mislukte) verstuurpoging live valideren op blur —
    // daarvoor zou een foutmelding al verschijnen zodra je simpelweg een
    // veld aanklikt en weer verlaat, nog voor je iets fout kon doen.
    let heeftGepoogdVersturen = false;

    const setError = (naam: string, message: string) => {
      const input = document.getElementById(naam) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | null;
      const fout = document.getElementById(`${naam}-fout`);
      if (!input || !fout) return;

      if (message) {
        fout.textContent = message;
        fout.hidden = false;
        input.setAttribute("aria-invalid", "true");
      } else {
        fout.textContent = "";
        fout.hidden = true;
        input.removeAttribute("aria-invalid");
      }
    };

    const valideerVeld = (naam: (typeof velden)[number]) => {
      const input = document.getElementById(naam) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | null;
      if (!input) return true;

      if (input.validity.valueMissing) {
        setError(naam, "Dit veld is verplicht.");
        return false;
      }
      if (input instanceof HTMLInputElement && input.validity.typeMismatch) {
        setError(naam, "Vul een geldig e-mailadres in.");
        return false;
      }
      setError(naam, "");
      return true;
    };

    // Na verzenden maakt het formulier plaats voor de bevestiging; met
    // "Nog een bericht sturen" komt het (leeg) weer terug.
    const bevestiging = document.getElementById("contact-bevestiging");
    const toonBevestiging = () => {
      if (!bevestiging) {
        statusEl.textContent = "Bedankt, je bericht is verstuurd!";
        return;
      }
      form.hidden = true;
      bevestiging.hidden = false;
      document.getElementById("contact-bevestiging-titel")?.focus();
    };
    document.getElementById("contact-opnieuw")?.addEventListener("click", () => {
      if (!bevestiging) return;
      bevestiging.hidden = true;
      form.hidden = false;
      heeftGepoogdVersturen = false;
      document.getElementById("naam")?.focus();
    });

    velden.forEach((naam) => {
      document.getElementById(naam)?.addEventListener("blur", () => {
        if (heeftGepoogdVersturen) valideerVeld(naam);
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      heeftGepoogdVersturen = true;

      const isGeldig = velden.map(valideerVeld).every(Boolean);
      if (!isGeldig) {
        statusEl.textContent = "Controleer de gemarkeerde velden hierboven.";
        return;
      }

      const turnstileToken = new FormData(form).get("cf-turnstile-response");
      if (widget && !turnstileToken) {
        statusEl.textContent =
          "Even geduld, de controle tegen spam is nog bezig. Probeer het zo nog een keer.";
        return;
      }

      submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = "Versturen…";
      statusEl.textContent = "";

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await response.json().catch(() => null);

        if (response.ok) {
          toonBevestiging();
          // Conversie in Google Analytics (key event "generate_lead").
          (window as Window & { gtag?: (...args: unknown[]) => void }).gtag?.(
            "event",
            "generate_lead",
            { form_name: "contact" },
          );
          form.reset();
          if (tsField) tsField.value = String(Date.now());
        } else {
          statusEl.textContent =
            data?.message ??
            "Er ging iets mis bij het versturen. Probeer het later opnieuw of bel ons.";
        }
      } catch {
        statusEl.textContent =
          "Er ging iets mis bij het versturen. Probeer het later opnieuw of bel ons.";
      } finally {
        // Een Turnstile-token is maar één keer bruikbaar.
        resetTurnstile();
        submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = "Versturen";
      }
    });
  }
  });
</script>
