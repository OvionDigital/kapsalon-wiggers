---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalerijItem {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  items: GalerijItem[];
}

const { items } = Astro.props;
---

{
  /* Uniforme 1x1-tegels i.p.v. een bento-achtig patroon met wisselende
     spans: bij een willekeurig aantal items (nu 9) gaf dat een grid dat niet
     netjes rechthoekig uitkwam (een tegel stak eronderuit). Met gelijke
     tegels op een vaste aspect-ratio blijft het geheel altijd een nette
     rechthoek, ongeacht het aantal foto's. */
}
<div
  class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible md:pb-0"
>
  {
    items.map((item) => (
      <button
        type="button"
        data-lightbox-trigger
        aria-label={`${item.alt} — klik om te vergroten`}
        class="group relative aspect-square w-64 shrink-0 snap-start cursor-pointer overflow-hidden rounded-md focus-visible:outline-2 focus-visible:outline-(--color-hover) focus-visible:outline-offset-2 md:w-auto md:shrink"
      >
        <Image
          src={item.src}
          alt={item.alt}
          width={600}
          height={600}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-(--transition-duration) group-hover:scale-105"
        />
        <span
          class="absolute inset-0 flex items-center justify-center bg-ink/0 opacity-0 transition-[opacity,background-color] duration-(--transition-duration) group-hover:bg-ink/30 group-hover:opacity-100 group-focus-visible:bg-ink/30 group-focus-visible:opacity-100"
          aria-hidden="true"
        >
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-white drop-shadow"
          >
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
            <line x1="11" y1="8" x2="11" y2="14" />
            <line x1="8" y1="11" x2="14" y2="11" />
          </svg>
        </span>
      </button>
    ))
  }
</div>
