---
/**
 * TopBar — dunne balk boven de hoofdnavigatie met de kerngegevens voor het
 * maken van een afspraak: telefoon en e-mail. Schuift dicht bij het scrollen
 * naar beneden en komt terug bij scrollen naar boven (zie Header.astro), via
 * een max-height/opacity-overgang op deze wrapper.
 *
 * Alleen vanaf md zichtbaar — op mobiel is er geen ruimte en staat dezelfde
 * info in de boekingskaart en de footer.
 */
import { vestigingen } from "../data/vestigingen";
import { getTelHref } from "../lib/salon";

const vestiging = vestigingen[0];
---

<div
  id="top-bar"
  class="top-bar hidden border-b border-border bg-cream md:block"
>
  <div
    class="container flex items-center justify-between gap-4 py-2 text-small text-muted"
  >
    <span
      class="inline-flex items-center gap-1.5 text-[0.7rem] font-semibold tracking-[0.12em] uppercase"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      Alleen op afspraak
    </span>

    <span class="flex items-center gap-6">
      <a
        href={`tel:${getTelHref(vestiging.telefoon)}`}
        class="inline-flex items-center gap-1.5 font-semibold no-underline transition-colors duration-(--transition-duration) hover:text-ink"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"
          ></path>
        </svg>
        {vestiging.telefoon}
      </a>
      <a
        href={`mailto:${vestiging.email}`}
        class="inline-flex items-center gap-1.5 no-underline transition-colors duration-(--transition-duration) hover:text-ink"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        {vestiging.email}
      </a>
    </span>
  </div>
</div>

<style>
  .top-bar {
    max-height: 3rem;
    overflow: hidden;
    opacity: 1;
    transition:
      max-height var(--transition-duration) ease,
      opacity var(--transition-duration) ease,
      border-color var(--transition-duration) ease;
  }

  .top-bar.top-bar--hidden {
    max-height: 0;
    opacity: 0;
    border-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .top-bar {
      transition: none;
    }
  }
</style>
