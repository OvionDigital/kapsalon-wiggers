---
/**
 * Lightbox — één gedeelde dialoog per pagina, geopend door elk element met
 * data-lightbox-trigger (zie GalerijGrid.astro). Pakt de al geladen
 * thumbnail-<img> van de trigger zelf, dus geen aparte hi-res bron nodig.
 */
---

<dialog
  id="lightbox"
  aria-label="Afbeelding uitvergroot"
  class="fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-0 backdrop:bg-ink/90"
>
  <div class="relative flex h-full w-full items-center justify-center p-4 sm:p-10">
    <button
      type="button"
      id="lightbox-sluiten"
      aria-label="Sluiten"
      class="absolute top-4 right-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-cream/90 text-ink transition-colors duration-(--transition-duration) hover:bg-cream"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-vorige"
      aria-label="Vorige afbeelding"
      class="absolute left-2 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-cream/90 text-ink transition-colors duration-(--transition-duration) hover:bg-cream sm:left-4"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button
      type="button"
      id="lightbox-volgende"
      aria-label="Volgende afbeelding"
      class="absolute right-2 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-cream/90 text-ink transition-colors duration-(--transition-duration) hover:bg-cream sm:right-4"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <img
      id="lightbox-image"
      src=""
      alt=""
      class="max-h-full max-w-full rounded-md object-contain"
    />
  </div>
</dialog>

<script>
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lightbox-image") as HTMLImageElement | null;
  const closeButton = document.getElementById("lightbox-sluiten");
  const vorigeButton = document.getElementById("lightbox-vorige");
  const volgendeButton = document.getElementById("lightbox-volgende");

  // Eén dialoog per pagina, dus alle triggers op de pagina vormen samen de
  // "reeks" waar de pijltjes doorheen bladeren.
  let triggers: HTMLElement[] = [];
  let huidigeIndex = 0;

  function lockScroll() {
    const scrollbarWidth =
      window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.classList.add("no-scroll");
    if (scrollbarWidth > 0) {
      document.body.style.paddingRight = `${scrollbarWidth}px`;
    }
  }

  function unlockScroll() {
    document.documentElement.classList.remove("no-scroll");
    document.body.style.paddingRight = "";
  }

  function toon(index: number) {
    if (!img || triggers.length === 0) return;
    huidigeIndex = (index + triggers.length) % triggers.length;
    const thumb = triggers[huidigeIndex].querySelector("img");
    if (!thumb) return;
    img.src = thumb.currentSrc || thumb.src;
    img.alt = thumb.alt;
  }

  function openLightbox(trigger: HTMLElement) {
    if (!dialog || dialog.open) return;
    triggers = Array.from(
      document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]"),
    );
    toon(triggers.indexOf(trigger));
    dialog.showModal();
    lockScroll();
  }

  function closeLightbox() {
    dialog?.close();
  }

  dialog?.addEventListener("close", unlockScroll);

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeLightbox();
  });

  closeButton?.addEventListener("click", closeLightbox);
  vorigeButton?.addEventListener("click", () => toon(huidigeIndex - 1));
  volgendeButton?.addEventListener("click", () => toon(huidigeIndex + 1));

  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") toon(huidigeIndex - 1);
    if (event.key === "ArrowRight") toon(huidigeIndex + 1);
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    const trigger = target?.closest<HTMLElement>("[data-lightbox-trigger]");
    if (!trigger) return;

    openLightbox(trigger);
  });
</script>
